{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:racette:hcf:result:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "hcf.result/1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "node_id": {
      "enum": [
        "pc",
        "mac",
        "fixture"
      ]
    },
    "execution_mode": {
      "enum": [
        "LOCAL_INFERENCE",
        "SYNTHETIC_EXAMPLE"
      ]
    },
    "status": {
      "enum": [
        "COMPLETED",
        "BLOCKED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED",
        "INVALID_OUTPUT"
      ]
    },
    "completion_state": {
      "enum": [
        "COMPLETE",
        "TRUNCATED",
        "UNKNOWN"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 150
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 150
        }
      },
      "required": [
        "name",
        "digest"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elapsed_ms": {
          "type": "number",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      },
      "required": [
        "elapsed_ms",
        "input_tokens",
        "output_tokens",
        "finish_reason"
      ]
    },
    "observations": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        },
        "required": [
          "text",
          "source_ids"
        ]
      }
    },
    "claim_checks": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "verdict": {
            "enum": [
              "SUPPORTED",
              "UNSUPPORTED",
              "UNCERTAIN"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "claim_id",
          "verdict",
          "source_ids",
          "reason"
        ]
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "error_code": {
      "enum": [
        null,
        "INVALID_TASK",
        "UNAVAILABLE_NODE",
        "UNAVAILABLE_MODEL",
        "UNVERIFIED_LOCAL_RUNTIME",
        "INVALID_OUTPUT",
        "TRUNCATED",
        "TIMEOUT",
        "CANCELLED",
        "IO_FAILED"
      ]
    }
  },
  "required": [
    "schema",
    "task_id",
    "task_sha256",
    "node_id",
    "execution_mode",
    "status",
    "completion_state",
    "model",
    "metrics",
    "observations",
    "claim_checks",
    "uncertainties",
    "error_code"
  ]
}
